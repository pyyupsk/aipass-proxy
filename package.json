{
  "name": "aipass-proxy",
  "version": "0.1.2",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "aipass-proxy": "./src/cli.ts"
  },
  "scripts": {
    "build": "bun build --compile --minify --bytecode --outfile dist/aipass-proxy ./src/cli.ts",
    "check": "biome check .",
    "install-service": "bun run src/cli.ts install-service",
    "prepare": "nit install",
    "setup": "bun run src/cli.ts setup",
    "start": "bun run src/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ai": "^7.0.97",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@pyyupsk/nit": "^0.3.0",
    "@types/bun": "^1.4.2",
    "@vitest/coverage-v8": "^5.0.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "nit": {
    "hooks": {
      "pre-commit": {
        "stages": {
          "*.{js,jsx,ts,tsx,json}": "bunx biome check {staged_files}"
        }
      },
      "pre-push": "bun run typecheck"
    }
  }
}
