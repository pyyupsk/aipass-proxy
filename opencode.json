{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "opencode",
    "ollama-cloud",
    "aipass"
  ],
  "provider": {
    "aipass": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AIPass",
      "options": {
        "baseURL": "http://localhost:47871/v1",
        "apiKey": "unused"
      },
      "models": {
        "gemini-3.1-flash-lite": {
          "name": "Gemini 3.1 Flash Lite"
        },
        "claude-sonnet-5@default": {
          "name": "Claude Sonnet 5"
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra"
        }
      }
    }
  }
}