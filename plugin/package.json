{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-aipass",
  "version": "0.1.1",
  "description": "OpenCode v2 plugin \u2014 dynamic aipass-proxy provider with auto-discovery from GET /v1/models",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "biome check --config-path ../.configs/biome.json .",
    "test": "vitest run --config ../.configs/vitest.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.8"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.112",
    "zod": "^4.1.8"
  },
  "keywords": [
    "opencode",
    "plugin",
    "openai-compatible",
    "aipass"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "5.8.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pyyupsk/aipass-proxy",
    "directory": "plugin"
  }
}
